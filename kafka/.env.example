# ============================================================
# ShopSphere Kafka Module — Environment Variables
# Team Dotenv | Garden City University Hackathon
# ============================================================
# Copy this file to kafka/.env and fill in real values.
# NEVER commit kafka/.env — it is listed in the root .gitignore.
# ============================================================
#
# AUTHENTICATION MODE: SASL/SCRAM-SHA-256 over TLS
# -------------------------------------------------
# This module uses SASL authentication (username + password).
# You need ONLY the CA certificate for TLS — NOT service.cert or service.key.
# Those files are only used for Aiven's separate certificate-based (mTLS) mode.
#
# See kafka/README.md for step-by-step credential setup instructions.
# ============================================================

# ----------------------------------------------------------
# Aiven Kafka — broker connection
# ----------------------------------------------------------

# Broker address from the Aiven console → Service Overview → Connection information → SASL
# Format: hostname:port  (the SASL port, NOT the certificate port — they differ)
KAFKA_BROKERS=dotenv-kafka-sweenydza-5eb5.f.aivencloud.com:24107

# Consumer group ID — all consumer instances sharing this ID load-balance messages.
KAFKA_GROUP_ID=shopsphere-order-consumer

# ----------------------------------------------------------
# Aiven Kafka — TLS (server verification only)
# ----------------------------------------------------------

# Base64-encoded CA certificate from Aiven (ca.pem).
# Download from: Aiven Console → dotenv-kafka → Overview → Connection information → CA Certificate
# Encode on Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem"))
# Encode on Linux/macOS:        base64 -w 0 ca.pem
# Paste the entire output as a single line below — no line breaks.
KAFKA_SSL_CA=

# ----------------------------------------------------------
# Aiven Kafka — SASL credentials
# ----------------------------------------------------------

# Username shown in the Aiven console under Connection information → SASL
KAFKA_SASL_USERNAME=avnadmin

# Password for the SASL user.
# Find it in: Aiven Console → dotenv-kafka → Users → avnadmin → Show password
# (or reset it there if you have not noted it)
KAFKA_SASL_PASSWORD=

# ----------------------------------------------------------
# Kafka topic
# ----------------------------------------------------------

# The topic to produce to and consume from.
# Create it in the Aiven console before running: dotenv-kafka → Topics → Create topic
KAFKA_TOPIC_ORDER_PLACED=order_placed
