# Copy this file to .env and replace every placeholder with your own values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (credentials are allowed).
CORS_ORIGIN=http://localhost:3000

# Aiven PostgreSQL connection string (placeholder only).
# Example shape: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# Aiven requires SSL. Set to true for Aiven.
DATABASE_SSL=true

# Secret used to sign session JWTs. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Session cookie settings.
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=shopsphere_session
CART_COOKIE_NAME=shopsphere_cart
# Secure cookies need HTTPS. Leave unset for local http://localhost.
# COOKIE_SECURE=false

# Rate limiting (optional overrides).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=120

# Tests only: point the suite at an existing throwaway database.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/shopsphere_test

# AI Virtual Try-On API Credentials (Optional - for AI clothing try-on)
# Providers: FASHN AI (https://fashn.ai), Replicate (https://replicate.com) or
# the free FASHN VTON v1.5 Hugging Face Space (no payment required).
# FASHN_API_KEY=fa-live-xxxx
# REPLICATE_API_TOKEN=r8_xxxx

# Optional Hugging Face read token for the free try-on Space.
# Create one at https://huggingface.co/settings/tokens (free account, no card).
# A free account gets ~5 GPU-minutes/day on ZeroGPU (~5 try-ons). The token is
# only read by the backend and is never sent to the browser.
# HF_TOKEN=hf_xxxx
