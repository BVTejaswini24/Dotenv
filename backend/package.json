{
  "name": "shopsphere-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ShopSphere backend API (Express + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:rollback": "tsx src/db/migrate.ts --rollback",
    "seed": "tsx src/db/seed-cli.ts",
    "seed:extract": "tsx --tsconfig ../tsconfig.json scripts/extract-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:search": "tsx scripts/test-search.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^5.1.1"
  }
}
